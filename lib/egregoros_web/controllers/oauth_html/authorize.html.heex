<Layouts.app flash={@flash} current_user={@current_user}>
  <AppShell.app_shell
    id="oauth-authorize-shell"
    nav_id="oauth-authorize-nav"
    main_id="oauth-authorize-main"
    active={:settings}
    current_user={@current_user}
  >
    <section class="mx-auto max-w-xl rounded-3xl border border-white/80 bg-white/80 p-8 shadow-xl shadow-slate-200/40 backdrop-blur dark:border-slate-700/60 dark:bg-slate-900/70 dark:shadow-slate-900/40">
      <p class="text-xs uppercase tracking-[0.35em] text-slate-500 dark:text-slate-400">
        OAuth
      </p>
      <h2 class="mt-2 font-display text-2xl text-slate-900 dark:text-slate-100">
        Authorize {@app.name}
      </h2>

      <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
        This app is requesting:
        <span class="font-semibold text-slate-900 dark:text-slate-100">{@scope}</span>
      </p>

      <%= if @mini_app_registration do %>
        <div
          id="oauth-mini-app-origin"
          class="mt-5 border-2 border-[color:var(--border-default)] bg-[color:var(--bg-subtle)] p-4"
        >
          <p class="text-xs font-bold uppercase tracking-wide text-[color:var(--text-muted)]">
            Fediverse mini app
          </p>
          <p class="mt-1 font-mono text-sm font-bold text-[color:var(--text-primary)]">
            {@mini_app_registration.app_origin}
          </p>
          <p class="mt-2 text-xs leading-relaxed text-[color:var(--text-muted)]">
            Authorization returns only to this app’s exact registered origin. Its requested scopes are fixed by the verified manifest.
          </p>
        </div>

        <div id="oauth-mini-app-permissions" class="mt-3 space-y-2">
          <div
            :for={scope <- @requested_scopes}
            id={"oauth-permission-#{scope}"}
            class={[
              "border-2 p-4",
              oauth_permission(scope).risk == :base &&
                "border-[color:var(--border-default)] bg-[color:var(--bg-subtle)]",
              oauth_permission(scope).risk == :sensitive &&
                "border-[color:var(--warning)] bg-[color:var(--warning-subtle)]",
              oauth_permission(scope).risk == :danger &&
                "border-[color:var(--danger)] bg-[color:var(--danger-subtle)]"
            ]}
          >
            <p class="text-sm font-bold text-[color:var(--text-primary)]">
              {oauth_permission(scope).title}
            </p>
            <p class="mt-1 text-xs leading-relaxed text-[color:var(--text-secondary)]">
              {oauth_permission(scope).description}
            </p>
            <p
              :if={@mini_app_registration.scope_authorization_max_age_seconds[scope]}
              class="mt-2 text-xs font-bold text-[color:var(--text-primary)]"
            >
              Manifest maximum: {format_authorization_lifetime(
                @mini_app_registration.scope_authorization_max_age_seconds[scope]
              )}
            </p>
          </div>
        </div>

        <div
          :if={"compose_note" in @mini_app_registration.capabilities}
          id="oauth-mini-app-capabilities"
          class="mt-3 border-2 border-[color:var(--warning)] bg-[color:var(--warning-subtle)] p-4"
        >
          <p class="text-sm font-bold text-[color:var(--text-primary)]">
            Host capability: compose a note
          </p>
          <p class="mt-1 text-xs leading-relaxed text-[color:var(--text-secondary)]">
            This app can ask Egregoros to open a prefilled note draft. It can never submit the draft; you must review it and press the host’s post button yourself.
          </p>
        </div>
      <% end %>

      <.form
        for={@form}
        id="oauth-authorize-form"
        action={~p"/oauth/authorize"}
        class="mt-8 space-y-4"
      >
        <.input type="hidden" field={@form[:client_id]} />
        <.input type="hidden" field={@form[:redirect_uri]} />
        <.input type="hidden" field={@form[:response_type]} />
        <.input type="hidden" field={@form[:scope]} />
        <.input type="hidden" field={@form[:state]} />
        <.input type="hidden" field={@form[:code_challenge]} />
        <.input type="hidden" field={@form[:code_challenge_method]} />

        <div :if={@mini_app_registration} class="space-y-2">
          <.input
            id="oauth-authorization-lifetime"
            type="select"
            field={@form[:authorization_lifetime_seconds]}
            options={@authorization_lifetime_options}
            label="How long should this authorization remain usable?"
          />
          <p class="text-xs leading-relaxed text-[color:var(--text-muted)]">
            You may shorten the app’s request. Refreshing credentials cannot extend this absolute deadline; after it expires, the app must ask again.
          </p>
        </div>

        <div
          :if={@mini_app_registration && "write" in @requested_scopes}
          class="border-2 border-[color:var(--danger)] bg-[color:var(--danger-subtle)] p-4"
        >
          <.input
            id="oauth-write-confirmation"
            type="checkbox"
            field={@form[:write_confirmed]}
            required
            label="I understand this app can use the API to create, edit, and delete content as my account."
          />
          <p class="mt-2 text-xs font-bold text-[color:var(--danger)]">
            You must check this box before Authorize can continue.
          </p>
          <p class="mt-2 text-xs leading-relaxed text-[color:var(--danger)]">
            This API permission is separate from the host composer: mini-app compose actions still open a prefilled draft and never submit it automatically.
          </p>
        </div>

        <.button type="submit" class="w-full">Authorize</.button>
        <a
          id="oauth-cancel"
          href={@cancel_url}
          class="inline-flex w-full items-center justify-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
        >
          Cancel
        </a>
      </.form>
    </section>
  </AppShell.app_shell>
</Layouts.app>
