{
  # For production, make sure ports 80/443 are reachable by Let's Encrypt.
  #
  # If you want to set an ACME email address, add this line:
  #   email you@example.com
  #
  # or edit this file to your needs.
}

(proxy_to_web) {
  reverse_proxy web:4000
}

(proxy_to_pleroma_fe) {
  reverse_proxy pleroma_fe:80
}

(proxy_to_pl_fe) {
  reverse_proxy pl_fe:80
}

# CSP is intentionally absent here. Egregoros emits route-specific policies:
# the main UI may frame only its same-origin broker, and each broker may frame
# one validated mini-app origin. A static proxy CSP would weaken or break that
# boundary.
(security_headers) {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), display-capture=()"
    -Server
  }
}

{$EGREGOROS_DOMAIN} {
  encode zstd gzip
  import security_headers
  import proxy_to_web
}

i.{$EGREGOROS_DOMAIN} {
  encode zstd gzip
  import security_headers

  @uploads path /uploads/*
  handle @uploads {
    import proxy_to_web
  }

  handle {
    respond "Not found" 404
  }
}

fe.{$EGREGOROS_DOMAIN} {
  encode zstd gzip
  import security_headers
  import proxy_to_pleroma_fe
}

pl-fe.{$EGREGOROS_DOMAIN} {
  encode zstd gzip
  import security_headers
  import proxy_to_pl_fe
}
